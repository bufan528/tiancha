{
  "name": "diaoyan-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "一级市场投研工作台（Pi 底座 v2.0）",
  "bin": {
    "tiancha": "dist/cli/tiancha.js",
    "pi": "dist/cli/tiancha.js"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --outfile=dist/server.js --external:@aws-sdk/* --external:@google/* --external:@anthropic-ai/* --external:openai --external:@silvia-odwyer/photon-node --external:canvas --external:utf-8-validate --external:bufferutil --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\"",
    "build:cli": "esbuild src/cli/tiancha.ts --bundle --platform=node --format=esm --outfile=dist/cli/tiancha.js --external:@earendil-works/* --external:@earendil-works/pi-coding-agent --external:@earendil-works/pi-ai --external:node:sqlite --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\"",
    "start": "node dist/server.js",
    "tiancha": "node --import tsx src/cli/tiancha.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:research": "npm --prefix packages/research run typecheck",
    "test:research": "node --import tsx --test packages/research/src/**/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.86.1",
    "@earendil-works/pi-coding-agent": "^0.86.1",
    "@tiancha/research": "file:packages/research",
    "typebox": "^1.3.27"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.22.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
